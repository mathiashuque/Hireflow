# Default: copy your Neon connection details from the Neon dashboard.
# Prefer a direct endpoint while running EF Core migrations.
DATABASE_CONNECTION_STRING=Host=ep-example.us-east-2.aws.neon.tech;Port=5432;Database=neondb;Username=neondb_owner;Password=replace-me;SSL Mode=Require
NEXT_PUBLIC_API_URL=http://localhost:8080
# The frontend origin the API accepts credentialed (cookie-authenticated) requests
# from. Must be an explicit origin, never a wildcard, because credentialed CORS
# cannot use one.
FRONTEND_ORIGIN=http://localhost:3000
