# Default: copy your Neon connection details from the Neon dashboard.
# Prefer a direct endpoint while running EF Core migrations.
DATABASE_CONNECTION_STRING=Host=ep-example.us-east-2.aws.neon.tech;Port=5432;Database=neondb;Username=neondb_owner;Password=replace-me;SSL Mode=Require
NEXT_PUBLIC_API_URL=http://localhost:8080
# The frontend origin the API accepts credentialed (cookie-authenticated) requests
# from. Must be an explicit origin, never a wildcard, because credentialed CORS
# cannot use one.
FRONTEND_ORIGIN=http://localhost:3000

# --- Production (Render + Neon + Vercel) reference values -----------------------------
# These are never read from this file in Production; they document the two distinct
# Neon endpoints and the Vercel proxy variable described in README.md's Operations
# section. Set the real values as dashboard/environment secrets on Render and Vercel,
# never in a committed .env file.

# Render `ConnectionStrings__Database` — Neon's *pooled* endpoint (runtime API traffic).
# NEON_POOLED_CONNECTION_STRING=Host=ep-example-pooler.us-east-2.aws.neon.tech;Port=5432;Database=neondb;Username=neondb_owner;Password=replace-me;SSL Mode=Require

# Used only when running EF Core migrations against Production — Neon's *direct*
# (non-pooled) endpoint. Never set on the Render web service itself.
# NEON_DIRECT_CONNECTION_STRING=Host=ep-example.us-east-2.aws.neon.tech;Port=5432;Database=neondb;Username=neondb_owner;Password=replace-me;SSL Mode=Require

# Vercel Production env var (server-side only — no NEXT_PUBLIC_ prefix). The Render API
# origin that the frontend's /api/:path* rewrite proxies same-origin requests to.
# API_PROXY_TARGET=https://hireflow-api.onrender.com
